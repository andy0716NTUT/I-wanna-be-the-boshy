# Opt-in graphical integration runners. Never linked into the shipped game.
cmake_path(CONVERT "${BOSHY_ORIGINAL_SOURCE_DIR}" TO_CMAKE_PATH_LIST BOSHY_ORIGINAL_SOURCE_DIR NORMALIZE)
if(NOT IS_DIRECTORY "${BOSHY_ORIGINAL_SOURCE_DIR}/src")
    message(FATAL_ERROR "First run scripts/prepare_original_probe.py and set BOSHY_ORIGINAL_SOURCE_DIR")
endif()
get_target_property(game_sources ${PROJECT_NAME} SOURCES)
set(scene_sources)
set(original_sources)
foreach(source IN LISTS game_sources)
    if(NOT IS_ABSOLUTE "${source}")
        set(source "${CMAKE_CURRENT_SOURCE_DIR}/${source}")
    endif()
    file(RELATIVE_PATH relative "${CMAKE_CURRENT_SOURCE_DIR}" "${source}")
    if(relative MATCHES "^src/.*\\.cpp$" AND
       NOT relative MATCHES "^src/(main|RuntimePaths)\\.cpp$")
        list(APPEND scene_sources "${source}")
        list(APPEND original_sources "${BOSHY_ORIGINAL_SOURCE_DIR}/${relative}")
    endif()
endforeach()
foreach(probe IN ITEMS BoshyPhase1Probe BoshyOriginalProbe BoshyOriginalGame)
    if(probe STREQUAL "BoshyOriginalProbe" OR probe STREQUAL "BoshyOriginalGame")
        set(probe_sources ${original_sources})
        set(probe_include "${BOSHY_ORIGINAL_SOURCE_DIR}/include")
    else()
        set(probe_sources ${scene_sources})
        set(probe_include "${CMAKE_CURRENT_SOURCE_DIR}/include")
    endif()
    if(probe STREQUAL "BoshyOriginalGame")
        set(entry_sources "${BOSHY_ORIGINAL_SOURCE_DIR}/src/main.cpp")
    else()
        set(entry_sources tests/SceneProbe.cpp src/RuntimePaths.cpp)
    endif()
    add_executable(${probe} EXCLUDE_FROM_ALL ${entry_sources} ${probe_sources})
    target_include_directories(${probe} BEFORE PRIVATE "${probe_include}")
    target_include_directories(${probe} PRIVATE include "${ptsd_SOURCE_DIR}/include")
    target_include_directories(${probe} SYSTEM PRIVATE ${DEPENDENCY_INCLUDE_DIRS})
    target_compile_definitions(${probe} PRIVATE RESOURCE_DIR="Resources")
    target_link_libraries(${probe} PRIVATE SDL2::SDL2main PTSD)
    set_target_properties(${probe} PROPERTIES RUNTIME_OUTPUT_DIRECTORY "${CMAKE_BINARY_DIR}/bin/$<CONFIG>")
    add_dependencies(${probe} ${PROJECT_NAME})
endforeach()
