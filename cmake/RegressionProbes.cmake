# Fresh generated sources must be prepared explicitly; never alter the reference checkout.
get_target_property(regression_game_sources ${PROJECT_NAME} SOURCES)
include("${CMAKE_CURRENT_LIST_DIR}/OriginalGameSources.cmake")
foreach(version IN ITEMS Original Current)
    set(generated "${CMAKE_CURRENT_SOURCE_DIR}/build/regression-source/${version}")
    if(NOT EXISTS "${generated}/manifest.json")
        message(FATAL_ERROR "Run scripts/prepare_regression_sources.py before enabling regression probes")
    endif()
    set(regression_sources)
    if(version STREQUAL "Original")
        foreach(relative IN LISTS BOSHY_ORIGINAL_GAME_SOURCES)
            list(APPEND regression_sources "${generated}/${relative}")
        endforeach()
    else()
    foreach(source IN LISTS regression_game_sources)
        if(NOT IS_ABSOLUTE "${source}")
            set(source "${CMAKE_CURRENT_SOURCE_DIR}/${source}")
        endif()
        file(RELATIVE_PATH relative "${CMAKE_CURRENT_SOURCE_DIR}" "${source}")
        if(relative MATCHES "^src/.*\\.cpp$" AND NOT relative MATCHES "^src/(main|RuntimePaths)\\.cpp$")
            list(APPEND regression_sources "${generated}/${relative}")
        endif()
    endforeach()
    endif()
    set(probe "Boshy${version}Regression")
    add_executable(${probe} EXCLUDE_FROM_ALL tests/RegressionProbe.cpp src/RuntimePaths.cpp ${regression_sources})
    target_include_directories(${probe} BEFORE PRIVATE "${generated}/include")
    target_include_directories(${probe} PRIVATE tests include "${ptsd_SOURCE_DIR}/include")
    target_include_directories(${probe} SYSTEM PRIVATE ${DEPENDENCY_INCLUDE_DIRS})
    target_compile_definitions(${probe} PRIVATE RESOURCE_DIR="Resources")
    target_link_libraries(${probe} PRIVATE SDL2::SDL2main PTSD)
    set_target_properties(${probe} PROPERTIES RUNTIME_OUTPUT_DIRECTORY "${CMAKE_BINARY_DIR}/bin/$<CONFIG>")
    add_dependencies(${probe} ${PROJECT_NAME})
endforeach()
