file(GLOB_RECURSE source_files RELATIVE "${SOURCE}" "${SOURCE}/Resources/*")
if(NOT source_files)
    message(FATAL_ERROR "No source resources in ${SOURCE}/Resources")
endif()
list(APPEND source_files config.json)
foreach(relative IN LISTS source_files)
    if(NOT EXISTS "${DEPLOYED}/${relative}")
        message(FATAL_ERROR "Missing deployed file: ${DEPLOYED}/${relative}")
    endif()
    file(SHA256 "${SOURCE}/${relative}" expected)
    file(SHA256 "${DEPLOYED}/${relative}" actual)
    if(NOT actual STREQUAL expected)
        message(FATAL_ERROR "Deployed bytes differ: ${relative}")
    endif()
endforeach()
file(GLOB shaders RELATIVE "${PTSD_SOURCE}/assets/shaders" "${PTSD_SOURCE}/assets/shaders/*")
foreach(shader IN LISTS shaders)
    file(SHA256 "${PTSD_SOURCE}/assets/shaders/${shader}" expected)
    file(SHA256 "${DEPLOYED}/PTSDAssets/shaders/${shader}" actual)
    if(NOT actual STREQUAL expected)
        message(FATAL_ERROR "Deployed shader differs: ${shader}")
    endif()
endforeach()
message(STATUS "Deployed Resources, config and shaders match source bytes")
